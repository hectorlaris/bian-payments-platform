{
  "name": "Payments MVP - AWS (Cognito)",
  "values": [
    {
      "key": "baseUrl",
      "value": "https://<api-id>.execute-api.eu-west-1.amazonaws.com",
      "type": "default",
      "enabled": true
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "readOnlyToken",
      "value": "",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "tokenUrl",
      "value": "https://<cognito-domain>.auth.eu-west-1.amazoncognito.com/oauth2/token",
      "type": "default",
      "enabled": true
    },
    {
      "key": "tokenScope",
      "value": "https://api.example-bank.com/payments.initiate https://api.example-bank.com/payments.read",
      "type": "default",
      "enabled": true
    },
    {
      "key": "cognitoBasicAuth",
      "value": "<base64(clientId:clientSecret)>",
      "type": "secret",
      "enabled": true
    }
  ],
  "_postman_variable_scope": "environment"
}
